# Copy to .env and fill in. .env is gitignored; never commit real keys.

# The real Anthropic API key. Only the gateway holds it.
ANTHROPIC_API_KEY=sk-ant-...
# Upstream API base URL (override only for testing).
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Upstream request timeout in seconds.
UPSTREAM_TIMEOUT_S=600

# Postgres connection (async driver). Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway

# Privacy switch. false = store metrics only (tokens, cost, latency, status, tags).
# true = also store full request and response bodies (needed for automatic
# categorization and handoff docs in later stages).
STORE_CONTENT=false

# Price table used to compute cost per call.
PRICE_TABLE_PATH=config/prices.yaml

# Spend budget per session (USD), unless set per session via the X-Session-Budget-Usd
# header or the admin API (admin takes precedence).
DEFAULT_SESSION_BUDGET_USD=5.00
# Whether clients may set their own session budgets with that header (false = admin only).
ALLOW_CLIENT_BUDGETS=true
# Alert when a session reaches these fractions of its budget or context window (JSON list).
ALERT_THRESHOLDS=[0.8, 1.0]

# Token for the /admin API (Authorization: Bearer ...). Leave empty to disable it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Models the gateway itself calls in later stages.
HANDOFF_MODEL=claude-sonnet-5-5
CLASSIFIER_MODEL=claude-haiku-5-5
