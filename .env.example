# Copy to .env and fill in. .env is gitignored; never commit real keys.

# The real Anthropic API key. Only the gateway holds it.
ANTHROPIC_API_KEY=sk-ant-...
# Upstream API base URL (override only for testing).
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Upstream request timeout in seconds.
UPSTREAM_TIMEOUT_S=600

# Postgres connection (async driver). Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway

# Privacy switch. false = store metrics only (tokens, cost, latency, status, tags).
# true = also store full request and response bodies (needed for automatic
# categorization and handoff docs in later stages).
STORE_CONTENT=false

# Price table used to compute cost per call.
PRICE_TABLE_PATH=config/prices.yaml

# Spend budget per session (USD), unless set per session via the X-Session-Budget-Usd
# header or the admin API (admin takes precedence).
DEFAULT_SESSION_BUDGET_USD=5.00
# Whether clients may set their own session budgets with that header (false = admin only).
ALLOW_CLIENT_BUDGETS=true
# Alert when a session reaches these fractions of its budget or context window (JSON list).
ALERT_THRESHOLDS=[0.8, 1.0]

# Let clients send their own Anthropic credential (e.g. Claude Code on a claude.ai plan),
# identified to the gateway by an X-Gateway-Key header; that credential is forwarded
# unchanged and the gateway's own key is not used. Costs for these calls are
# API-equivalent, not the gateway's spend.
ALLOW_CLIENT_CREDENTIALS=true

# Token for the /admin API (Authorization: Bearer ...). Leave empty to disable it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Models the gateway itself calls.
HANDOFF_MODEL=claude-sonnet-5-5
CLASSIFIER_MODEL=claude-haiku-5-5
CLASSIFIER_EFFORT=low

# Context handoff documents (need STORE_CONTENT=true): effort, the largest transcript sent
# to HANDOFF_MODEL in tokens, and the minimum seconds between generations per session.
HANDOFF_EFFORT=high
HANDOFF_MAX_INPUT_TOKENS=150000
HANDOFF_COOLDOWN_S=60

# Session categories (config/categories.yaml). A session's X-Category tag wins; otherwise
# the classifier reads the stored conversation, which needs STORE_CONTENT=true.
# The worker categorizes sessions idle for CATEGORIZE_IDLE_S, checking every
# CATEGORIZE_INTERVAL_S.
CATEGORIES_PATH=config/categories.yaml
CATEGORIZE_ENABLED=true
CATEGORIZE_IDLE_S=600
CATEGORIZE_INTERVAL_S=60
